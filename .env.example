# Endereço pelo qual os navegadores da rede acessam o servidor.
# Troque 192.168.100.X pelo IP (ou hostname) do servidor Linux.
# O acesso é por HTTPS, via Caddy (ver Caddyfile).
SERVER_HOST=192.168.100.X
NEXT_PUBLIC_API_URL=https://192.168.100.X:3008
FRONTEND_URL=https://192.168.100.X:3009

# true porque o acesso é por HTTPS.
COOKIE_SECURE=true

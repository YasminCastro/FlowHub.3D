// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model User {
  id                  String   @id @default(uuid())
  email               String   @unique
  name                String?
  password            String
  hashedRefreshToken  String?
  isEmailVerified     Boolean @default(false)
  verificationCode    String?
  verificationCodeExpiresAt DateTime?
  passwordResetCode   String?
  passwordResetCodeExpiresAt DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  categories Category[]
  printers Printer[]
  brands Brand[]
  filaments Filament[]
  extraItems ExtraItem[]
}


model Category {
  id        String   @id @default(uuid())
  name      String
  color     String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
}

model Printer {
  id        String   @id @default(uuid())
  name      String
  brand     String
  nozzle    String?
  extrusionType String?  
  filamentsTypes  String[]  @default([])
  powerConsumptionW      Float?
  energyCostPerKwh       Float?
  maintenanceCostPerHour Float?
  purchasePrice          Float?
  purchaseDate           DateTime?
  lastMaintenanceDate       DateTime?
  notes                 String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  maintenances PrinterMaintenance[]

  @@unique([userId, name])
}

enum MaintenanceType {
  LUBRICATION
  CLEANING
  NOZZLE_CHANGE
  OTHER
}

model PrinterMaintenance {
  id                String          @id @default(uuid())
  type              MaintenanceType
  date              DateTime
  printerHours      Float?
  cost              Float?
  description       String?
  remindAfterHours  Float?
  nozzleInstalled   String?
  nozzleRemoved     String?
  printerId         String
  printer           Printer         @relation(fields: [printerId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([printerId, date])
}

enum PurchaseChannel {
  OWN_SITE
  MERCADO_LIVRE
  AMAZON
  SHOPEE
  ALIEXPRESS
  PHYSICAL_STORE
  OTHER
}

enum BrandStatus {
  PURCHASED
  RESEARCHED
}

model Brand {
  id                      String            @id @default(uuid())
  name                    String
  website                 String?
  purchaseChannels        PurchaseChannel[] @default([])
  filamentTypes           String[]          @default([])
  status                  BrandStatus       @default(PURCHASED)
  // Faixa de preço por kg levantada enquanto a marca é só pesquisa.
  researchedMinPricePerKg Float?
  researchedMaxPricePerKg Float?
  // Cores preferidas em texto livre ("Pastéis", "Preto"), na ordem adicionada.
  preferredColors         String[]          @default([])
  isFavorite              Boolean           @default(false)
  archivedAt              DateTime?
  userId                  String
  user                    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  notes BrandNote[]
  filaments Filament[]

  @@unique([userId, name])
}

model BrandNote {
  id        String   @id @default(uuid())
  content   String
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId, createdAt])
}

enum FilamentAvailability {
  AVAILABLE
  SOLD_OUT
}

// Quanto tem no carretel, marcado à mão enquanto o consumo das impressões não
// é registrado.
enum SpoolLevel {
  FULL
  LOW
  FINISHED
}

// Um filamento é o produto (marca + tipo + cor), comprado uma ou mais vezes.
model Filament {
  id                String               @id @default(uuid())
  type              String
  colorName         String
  // De 1 a 3 cores em hex (#rrggbb), na ordem: rolos duo e tri color têm
  // mais de uma. A amostra mostra um degradê entre elas.
  colors            String[]
  spoolWeightGrams  Int
  // Preço pago pelo rolo inteiro (não por kg), menor e maior entre as compras.
  minPricePaid      Float
  maxPricePaid      Float?
  purchaseCount     Int                  @default(1)
  lastPurchasedAt   DateTime?
  purchaseChannel   PurchaseChannel?
  availability      FilamentAvailability @default(AVAILABLE)
  // Comprado no outlet: em geral troca de cor, um rolo bem específico.
  isOutlet          Boolean              @default(false)
  spoolLevel        SpoolLevel           @default(FULL)
  // Quando o carretel foi marcado como FINISHED; null nos outros níveis.
  finishedAt        DateTime?
  rating            Int?
  ratingComment     String?
  // Restrict: uma marca com filamentos não pode ser excluída, só arquivada.
  brandId           String
  brand             Brand                @relation(fields: [brandId], references: [id], onDelete: Restrict)
  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  notes FilamentNote[]

  @@unique([userId, brandId, type, colorName])
  @@index([brandId])
}

model FilamentNote {
  id         String   @id @default(uuid())
  content    String
  filamentId String
  filament   Filament @relation(fields: [filamentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([filamentId, createdAt])
}

// Argolas, ímãs, embalagens: o que entra na peça além do filamento. Comprado
// em lote e usado por unidade; o custo unitário sai do lote mais recente.
model ExtraItem {
  id        String   @id @default(uuid())
  name      String
  notes     String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lots ExtraItemLot[]

  @@unique([userId, name])
}

// Uma compra do item. O histórico mostra se o preço do lote subiu.
model ExtraItemLot {
  id          String    @id @default(uuid())
  // Preço pago pelo lote inteiro, não por unidade.
  price       Float
  quantity    Int
  purchasedAt DateTime
  extraItemId String
  extraItem   ExtraItem @relation(fields: [extraItemId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([extraItemId, purchasedAt])
}

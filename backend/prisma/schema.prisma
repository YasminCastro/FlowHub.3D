// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model User {
  id                  String   @id @default(uuid())
  email               String   @unique
  name                String?
  password            String
  hashedRefreshToken  String?
  isEmailVerified     Boolean @default(false)
  verificationCode    String?
  verificationCodeExpiresAt DateTime?
  passwordResetCode   String?
  passwordResetCodeExpiresAt DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  categories Category[]
  printers Printer[]
  brands Brand[]
  filaments Filament[]
  extraItems ExtraItem[]
  journalEntries JournalEntry[]
  costSettings CostSettings?
  printItems PrintItem[]
  printQueueEntries PrintQueueEntry[]
  catalogItems CatalogItem[]
  calibrations Calibration[]
  calibrationGuides CalibrationGuideProgress[]
}


model Category {
  id        String   @id @default(uuid())
  name      String
  color     String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  printItems PrintItem[]
  catalogItems CatalogItem[]

  @@unique([userId, name])
}

model Printer {
  id        String   @id @default(uuid())
  name      String
  brand     String
  nozzle    String?
  extrusionType String?  
  filamentsTypes  String[]  @default([])
  powerConsumptionW      Float?
  energyCostPerKwh       Float?
  maintenanceCostPerHour Float?
  purchasePrice          Float?
  purchaseDate           DateTime?
  lastMaintenanceDate       DateTime?
  notes                 String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  maintenances PrinterMaintenance[]
  printRecords PrintRecord[]
  printQueueEntries PrintQueueEntry[]
  calibrations Calibration[]
  calibrationGuides CalibrationGuideProgress[]

  @@unique([userId, name])
}

enum MaintenanceType {
  LUBRICATION
  CLEANING
  NOZZLE_CHANGE
  OTHER
}

model PrinterMaintenance {
  id                String          @id @default(uuid())
  type              MaintenanceType
  date              DateTime
  printerHours      Float?
  cost              Float?
  description       String?
  remindAfterHours  Float?
  nozzleInstalled   String?
  nozzleRemoved     String?
  printerId         String
  printer           Printer         @relation(fields: [printerId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([printerId, date])
}

enum PurchaseChannel {
  OWN_SITE
  MERCADO_LIVRE
  AMAZON
  SHOPEE
  ALIEXPRESS
  PHYSICAL_STORE
  OTHER
}

enum BrandStatus {
  PURCHASED
  RESEARCHED
}

model Brand {
  id                      String            @id @default(uuid())
  name                    String
  website                 String?
  purchaseChannels        PurchaseChannel[] @default([])
  filamentTypes           String[]          @default([])
  status                  BrandStatus       @default(PURCHASED)
  // Faixa de preço por kg levantada enquanto a marca é só pesquisa.
  researchedMinPricePerKg Float?
  researchedMaxPricePerKg Float?
  // Cores preferidas em texto livre ("Pastéis", "Preto"), na ordem adicionada.
  preferredColors         String[]          @default([])
  isFavorite              Boolean           @default(false)
  archivedAt              DateTime?
  userId                  String
  user                    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  notes BrandNote[]
  filaments Filament[]

  @@unique([userId, name])
}

model BrandNote {
  id        String   @id @default(uuid())
  content   String
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId, createdAt])
}

enum FilamentAvailability {
  AVAILABLE
  SOLD_OUT
}

// Quanto tem no carretel, marcado à mão enquanto o consumo das impressões não
// é registrado.
enum SpoolLevel {
  FULL
  LOW
  FINISHED
}

// Um filamento é o produto (marca + tipo + cor), comprado uma ou mais vezes.
model Filament {
  id                String               @id @default(uuid())
  type              String
  colorName         String
  // De 1 a 3 cores em hex (#rrggbb), na ordem: rolos duo e tri color têm
  // mais de uma. A amostra mostra um degradê entre elas.
  colors            String[]
  spoolWeightGrams  Int
  // Preço pago pelo rolo inteiro (não por kg), menor e maior entre as compras.
  minPricePaid      Float
  maxPricePaid      Float?
  purchaseCount     Int                  @default(1)
  lastPurchasedAt   DateTime?
  purchaseChannel   PurchaseChannel?
  availability      FilamentAvailability @default(AVAILABLE)
  // Comprado no outlet: em geral troca de cor, um rolo bem específico.
  isOutlet          Boolean              @default(false)
  spoolLevel        SpoolLevel           @default(FULL)
  // Quando o carretel foi marcado como FINISHED; null nos outros níveis.
  finishedAt        DateTime?
  rating            Int?
  ratingComment     String?
  // Configurações do fabricante (°C): faixa recomendada do bico e da mesa.
  nozzleTempMin     Int?
  nozzleTempMax     Int?
  bedTempMin        Int?
  bedTempMax        Int?
  // Restrict: uma marca com filamentos não pode ser excluída, só arquivada.
  brandId           String
  brand             Brand                @relation(fields: [brandId], references: [id], onDelete: Restrict)
  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  notes FilamentNote[]
  journalEntries JournalEntry[]
  printUsages PrintRecordFilament[]
  queueUsages PrintQueueFilament[]
  calibrations Calibration[]
  calibrationGuides CalibrationGuideProgress[]

  @@unique([userId, brandId, type, colorName])
  @@index([brandId])
}

model FilamentNote {
  id         String   @id @default(uuid())
  content    String
  filamentId String
  filament   Filament @relation(fields: [filamentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([filamentId, createdAt])
}

// Argolas, ímãs, embalagens: o que entra na peça além do filamento. Comprado
// em lote e usado por unidade; o custo unitário sai do lote mais recente.
model ExtraItem {
  id        String   @id @default(uuid())
  name      String
  notes     String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lots ExtraItemLot[]

  @@unique([userId, name])
}

// Uma compra do item. O histórico mostra se o preço do lote subiu.
model ExtraItemLot {
  id          String    @id @default(uuid())
  // Preço pago pelo lote inteiro, não por unidade.
  price       Float
  quantity    Int
  purchasedAt DateTime
  extraItemId String
  extraItem   ExtraItem @relation(fields: [extraItemId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([extraItemId, purchasedAt])
}

// Diário: um problema de impressão, o que foi tentado e o que resolveu.
enum JournalStatus {
  UNRESOLVED
  IN_PROGRESS
  RESOLVED
}

enum AttemptOutcome {
  WORKED
  FAILED
}

model JournalEntry {
  id             String        @id @default(uuid())
  title          String
  occurredAt     DateTime
  // RESOLVED vem de uma tentativa WORKED; sem ela, o usuário escolhe entre
  // IN_PROGRESS e UNRESOLVED.
  status         JournalStatus @default(IN_PROGRESS)
  symptom        String
  possibleCauses String        @default("")
  notes          String?
  // SetNull: excluir o filamento não apaga o histórico de problemas.
  filamentId     String?
  filament       Filament?     @relation(fields: [filamentId], references: [id], onDelete: SetNull)
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  attempts JournalAttempt[]
  photos   JournalPhoto[]

  @@index([userId, occurredAt])
  @@index([filamentId])
}

// Uma coisa testada para resolver o problema. A posição define a numeração.
model JournalAttempt {
  id          String          @id @default(uuid())
  position    Int
  description String
  // null = ainda não sabe se funcionou.
  outcome     AttemptOutcome?
  triedAt     DateTime
  note        String?
  entryId     String
  entry       JournalEntry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([entryId, position])
}

// Foto do problema, guardada em disco (UPLOADS_DIR) com nome aleatório.
model JournalPhoto {
  id        String       @id @default(uuid())
  filename  String       @unique
  entryId   String
  entry     JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@index([entryId, createdAt])
}

// Parâmetros globais de custo. Uma linha por usuário; sem linha, valem os
// padrões do serviço.
model CostSettings {
  id                    String   @id @default(uuid())
  energyCostPerKwh      Float
  currency              String   @default("BRL")
  laborCostPerHour      Float
  prepMinutesPerPiece   Int
  defaultMarginPercent  Float
  packagingCost         Float
  failureReservePercent Float
  otherFixedCost        Float    @default(0)
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

enum PrintOutcome {
  SUCCESS
  FAILURE
}

// Uma peça. Imprimir de novo acrescenta um registro dentro dela.
model PrintItem {
  id            String      @id @default(uuid())
  name          String
  modelUrl      String?
  // SetNull: excluir a categoria deixa a peça "sem categoria".
  categoryId    String?
  category      Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // Versão de outra peça (escala, base diferente...). Excluir a original não
  // apaga a derivada.
  derivedFromId String?
  derivedFrom   PrintItem?  @relation("PrintItemDerivation", fields: [derivedFromId], references: [id], onDelete: SetNull)
  derivatives   PrintItem[] @relation("PrintItemDerivation")
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  records PrintRecord[]
  queueEntries PrintQueueEntry[]
  catalogVariants CatalogVariant[]

  @@unique([userId, name])
  @@index([categoryId])
  @@index([derivedFromId])
}

// Uma vez em que a peça foi impressa. Exatamente um registro com sucesso por
// peça é o padrão (isDefault), garantido pelo serviço.
model PrintRecord {
  id            String       @id @default(uuid())
  printedAt     DateTime
  units         Int
  // Tempo da impressão inteira (todas as unidades). Na falha, até parar.
  totalMinutes  Int
  // SetNull: excluir a impressora não apaga o histórico; o nome fica.
  printerId     String?
  printer       Printer?     @relation(fields: [printerId], references: [id], onDelete: SetNull)
  printerName   String
  // Configuração do fatiador: opcional, tudo null quando não informada.
  slicer        String?
  layerHeightMm Float?
  infillPercent Int?
  infillPattern String?
  walls         Int?
  // Opcional: a Nova impressão não pede; o Novo registro aceita.
  temperatureC  Int?
  // Suporte, brim, velocidade e o resto, em texto livre.
  extras        String       @default("")
  outcome       PrintOutcome
  failureReason String?
  note          String?
  // Texto da coluna "O que mudou", montado em relação ao registro de base.
  changeSummary String?
  isDefault     Boolean      @default(false)
  itemId        String
  item          PrintItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  filaments PrintRecordFilament[]
  photos    PrintPhoto[]

  @@index([itemId, printedAt])
  @@index([printerId])
}

// Filamento gasto num registro. Guarda o preço por grama e a identificação do
// rolo daquele dia: o custo de uma impressão antiga não muda se o preço do
// filamento mudar ou se ele for excluído.
model PrintRecordFilament {
  id           String      @id @default(uuid())
  position     Int
  grams        Float
  pricePerGram Float
  colorName    String
  type         String
  brandName    String
  colors       String[]
  filamentId   String?
  filament     Filament?   @relation(fields: [filamentId], references: [id], onDelete: SetNull)
  recordId     String
  record       PrintRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId, position])
  @@index([filamentId])
}

model PrintPhoto {
  id        String      @id @default(uuid())
  filename  String      @unique
  recordId  String
  record    PrintRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  catalogPhotos CatalogPhoto[]

  @@index([recordId, createdAt])
}

// Fila de impressão: o que vai imprimir, na ordem, com um orçamento rápido.
// Concluído com sucesso, sai da fila (completedAt) e vira um registro em
// Impressões; se falha, continua na fila marcado com a última falha.
model PrintQueueEntry {
  id                String             @id @default(uuid())
  name              String
  // Ordem entre os pendentes (0 = o próximo). Nos concluídos não importa.
  position          Int
  units             Int
  // Tempo do lote inteiro (todas as unidades).
  totalMinutes      Int
  customer          String?
  modelUrl          String?
  // A impressão ligada: a escolhida ao adicionar ou onde foi registrada ao
  // concluir. SetNull: excluir a impressão não apaga o item da fila.
  printItemId       String?
  printItem         PrintItem?         @relation(fields: [printItemId], references: [id], onDelete: SetNull)
  // SetNull: excluir a impressora não apaga o item; o nome fica.
  printerId         String?
  printer           Printer?           @relation(fields: [printerId], references: [id], onDelete: SetNull)
  printerName       String
  lastFailureAt     DateTime?
  lastFailureReason String?
  completedAt       DateTime?
  // Concluído criando uma impressão nova (em vez de um registro numa que já
  // existia).
  createdItem       Boolean            @default(false)
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  filaments PrintQueueFilament[]

  @@index([userId, completedAt, position])
  @@index([printItemId])
  @@index([printerId])
}

// Filamento previsto para um item da fila, com o preço e a identificação do
// dia em que foi adicionado (como em PrintRecordFilament).
model PrintQueueFilament {
  id           String          @id @default(uuid())
  position     Int
  grams        Float
  pricePerGram Float
  colorName    String
  type         String
  brandName    String
  colors       String[]
  filamentId   String?
  filament     Filament?       @relation(fields: [filamentId], references: [id], onDelete: SetNull)
  entryId      String
  entry        PrintQueueEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId, position])
  @@index([filamentId])
}

// Catálogo: o que é vendido. Cada item se liga a uma ou mais impressões; o
// preço calculado sai do registro padrão delas (a conta fica no front, como
// o custo em Impressões) e pode ser sobrescrito.
enum CatalogKind {
  // Uma impressão, um preço.
  SINGLE
  // Uma impressão por tamanho, cada um com seu preço.
  SIZES
  // Várias impressões vendidas juntas, um preço para o kit.
  KIT
}

model CatalogItem {
  id          String      @id @default(uuid())
  name        String
  description String?
  kind        CatalogKind
  // Só em KIT; null usa a soma do calculado das peças.
  kitPrice    Float?
  // SetNull: excluir a categoria deixa o item "sem categoria".
  categoryId  String?
  category    Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  variants CatalogVariant[]
  photos   CatalogPhoto[]

  @@unique([userId, name])
  @@index([categoryId])
}

// Um tamanho (SIZES), a peça (SINGLE) ou uma das peças do kit (KIT).
model CatalogVariant {
  id            String      @id @default(uuid())
  position      Int
  // "P", "M", "G"... Vazio fora de SIZES.
  label         String      @default("")
  // null: usa o calculado. Em KIT fica null (o preço é do kit).
  priceOverride Float?
  // SetNull: excluir a impressão deixa a linha sem impressão ligada.
  printItemId   String?
  printItem     PrintItem?  @relation(fields: [printItemId], references: [id], onDelete: SetNull)
  catalogItemId String
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@index([catalogItemId, position])
  @@index([printItemId])
}

// Fotos escolhidas entre as dos registros das impressões ligadas. Excluir a
// foto (ou o registro) tira ela do catálogo.
model CatalogPhoto {
  position      Int
  catalogItemId String
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  photoId       String
  photo         PrintPhoto  @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@id([catalogItemId, photoId])
  @@index([photoId])
}

// Calibrações: os valores que funcionaram para um filamento, numa impressora,
// num fatiador. Uma por combinação; salvar de novo a mesma combinação guarda
// os valores anteriores em CalibrationVersion.
enum CalibrationSlicer {
  ORCA
  CREALITY
}

model Calibration {
  id                 String            @id @default(uuid())
  slicer             CalibrationSlicer
  // Multiplicador (1,00 = sem ajuste).
  flow               Float
  // Bico: camada inicial e demais camadas ("final").
  nozzleTempInitial  Int
  nozzleTemp         Int
  // Mesa: 1ª camada e demais camadas.
  bedTempFirstLayer  Int
  bedTemp            Int
  pressureAdvance    Float
  // Opcionais.
  // Vazão máxima que o hotend derrete este filamento, em mm³/s.
  maxVolumetricSpeed Float?
  retractionDistance Float?
  notes              String?
  calibratedAt       DateTime
  // Cascade: sem o filamento ou a impressora a calibração não significa nada.
  filamentId         String
  filament           Filament          @relation(fields: [filamentId], references: [id], onDelete: Cascade)
  printerId          String
  printer            Printer           @relation(fields: [printerId], references: [id], onDelete: Cascade)
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  versions CalibrationVersion[]

  @@unique([userId, filamentId, printerId, slicer])
  @@index([filamentId])
  @@index([printerId])
}

// Valores que a calibração tinha antes de ser substituída por uma nova.
model CalibrationVersion {
  id                 String      @id @default(uuid())
  flow               Float
  nozzleTempInitial  Int
  nozzleTemp         Int
  bedTempFirstLayer  Int
  bedTemp            Int
  pressureAdvance    Float
  maxVolumetricSpeed Float?
  retractionDistance Float?
  notes              String?
  calibratedAt       DateTime
  calibrationId      String
  calibration        Calibration @relation(fields: [calibrationId], references: [id], onDelete: Cascade)
  createdAt          DateTime    @default(now())

  @@index([calibrationId, calibratedAt])
}

// Progresso do guia "Por fatiador" para um filamento, numa impressora, num
// fatiador: o que já foi anotado em cada teste e qual está aberto. Uma linha
// por combinação; "Recomeçar" apaga a linha.
model CalibrationGuideProgress {
  id         String            @id @default(uuid())
  slicer     CalibrationSlicer
  // { [passo]: { values: { [campo]: número }, done: boolean } }. Os passos e
  // campos válidos ficam no serviço (GUIDE_STEP_FIELDS).
  results    Json              @default("{}")
  // Passo aberto na tela ("temperature", "maxFlow"...).
  activeStep String            @default("temperature")
  // Cascade: sem o filamento ou a impressora o progresso não significa nada.
  filamentId String
  filament   Filament          @relation(fields: [filamentId], references: [id], onDelete: Cascade)
  printerId  String
  printer    Printer           @relation(fields: [printerId], references: [id], onDelete: Cascade)
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([userId, filamentId, printerId, slicer])
  @@index([filamentId])
  @@index([printerId])
}

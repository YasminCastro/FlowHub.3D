// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model User {
  id                  String   @id @default(uuid())
  email               String   @unique
  name                String?
  password            String
  hashedRefreshToken  String?
  isEmailVerified     Boolean @default(false)
  verificationCode    String?
  verificationCodeExpiresAt DateTime?
  passwordResetCode   String?
  passwordResetCodeExpiresAt DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  categories Category[]
  printers Printer[]
  brands Brand[]
}


model Category {
  id        String   @id @default(uuid())
  name      String
  color     String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
}

model Printer {
  id        String   @id @default(uuid())
  name      String
  brand     String
  nozzle    String?
  extrusionType String?  
  filamentsTypes  String[]  @default([])
  powerConsumptionW      Float?
  energyCostPerKwh       Float?
  maintenanceCostPerHour Float?
  purchasePrice          Float?
  purchaseDate           DateTime?
  lastMaintenanceDate       DateTime?
  notes                 String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  maintenances PrinterMaintenance[]

  @@unique([userId, name])
}

enum MaintenanceType {
  LUBRICATION
  CLEANING
  NOZZLE_CHANGE
  OTHER
}

model PrinterMaintenance {
  id                String          @id @default(uuid())
  type              MaintenanceType
  date              DateTime
  printerHours      Float?
  cost              Float?
  description       String?
  remindAfterHours  Float?
  nozzleInstalled   String?
  nozzleRemoved     String?
  printerId         String
  printer           Printer         @relation(fields: [printerId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([printerId, date])
}

enum PurchaseChannel {
  OWN_SITE
  MERCADO_LIVRE
  AMAZON
  SHOPEE
  ALIEXPRESS
  PHYSICAL_STORE
  OTHER
}

enum BrandStatus {
  PURCHASED
  RESEARCHED
}

model Brand {
  id                      String            @id @default(uuid())
  name                    String
  website                 String?
  purchaseChannels        PurchaseChannel[] @default([])
  filamentTypes           String[]          @default([])
  status                  BrandStatus       @default(PURCHASED)
  // Faixa de preço por kg levantada enquanto a marca é só pesquisa.
  researchedMinPricePerKg Float?
  researchedMaxPricePerKg Float?
  // Cores preferidas em texto livre ("Pastéis", "Preto"), na ordem adicionada.
  preferredColors         String[]          @default([])
  isFavorite              Boolean           @default(false)
  archivedAt              DateTime?
  userId                  String
  user                    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  notes BrandNote[]

  @@unique([userId, name])
}

model BrandNote {
  id        String   @id @default(uuid())
  content   String
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId, createdAt])
}
